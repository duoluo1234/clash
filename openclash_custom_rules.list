rules:
  # WebRTC / STUN / TURN 阻断 + 国外 QUIC 阻断 (jin 2026-11-12 提供; 经 OpenClash 自定义规则置于规则表最前; 目标为模板 📹 WebRTC 组, 默认 REJECT, 组内可改走节点)
  # Block WebRTC / STUN / TURN
  - 'DOMAIN-KEYWORD,stunserver,📹 WebRTC'
  - 'DOMAIN-KEYWORD,turnserver,📹 WebRTC'
  - 'DOMAIN-REGEX,(^|\.)stun[0-9]*[.-],📹 WebRTC'
  - 'DOMAIN-REGEX,(^|\.)turn[0-9]*[.-],📹 WebRTC'
  # Metered / OpenRelay
  - 'DOMAIN-SUFFIX,openrelay.metered.ca,📹 WebRTC'
  - 'DOMAIN-SUFFIX,relay.metered.ca,📹 WebRTC'
  - 'DOMAIN-SUFFIX,meteredstun.ca,📹 WebRTC'
  # Known STUN / TURN endpoints
  - 'DOMAIN-SUFFIX,stunprotocol.org,📹 WebRTC'
  - 'DOMAIN-SUFFIX,freestun.net,📹 WebRTC'
  - 'DOMAIN,s1.taraba.net,📹 WebRTC'
  - 'DOMAIN,s2.taraba.net,📹 WebRTC'
  - 'DOMAIN,numb.viagenie.ca,📹 WebRTC'
  - 'DOMAIN,iphone-stun.strato-iphone.de,📹 WebRTC'
  - 'DOMAIN,relay.webwormhole.io,📹 WebRTC'
  - 'DOMAIN,meet-jit-si-turnrelay.jitsi.net,📹 WebRTC'
  # Standard STUN / TURN ports
  - 'DST-PORT,3478,📹 WebRTC'
  - 'DST-PORT,5349,📹 WebRTC'
  # Common WebRTC media / Google STUN ports
  - 'AND,((NETWORK,UDP),(DST-PORT,19302-19309)),📹 WebRTC'
  - 'AND,((NETWORK,UDP),(DST-PORT,10000)),📹 WebRTC'
  - 'AND,((NETWORK,UDP),(DST-PORT,5350)),📹 WebRTC'
  # 国内 QUIC 放行，其他 UDP/443 拒绝
  - 'AND,((GEOSITE,cn),(NETWORK,UDP),(DST-PORT,443)),DIRECT'
  - 'AND,((GEOIP,CN,no-resolve),(NETWORK,UDP),(DST-PORT,443)),DIRECT'
  - 'AND,((NETWORK,UDP),(DST-PORT,443)),📹 WebRTC'
